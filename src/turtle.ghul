namespace Raster is

    // A pen on an image, at a position and a heading, told how far to go
    // rather than where to go. A curve stated as a sequence of turns and
    // steps is written that way directly.
    //
    // Angles are in degrees and follow the image's coordinates: with a
    // `view` set, y increases upwards and a positive turn is
    // counter-clockwise; without one, y increases downwards and it is
    // the other way about.
    class TURTLE is
        _image: IMAGE

        _x: double
        _y: double
        _heading: double

        _drawing: bool

        init(image: IMAGE) is
            _image = image

            _x = 0.0D
            _y = 0.0D
            _heading = 0.0D

            _drawing = true
        si

        x: double => _x
        y: double => _y

        heading: double => _heading * 180.0D / Ghul.Math.pi

        // Puts the pen down at a position without drawing on the way.
        move_to(x: double, y: double) is
            _x = x
            _y = y
        si

        face(degrees: double) is
            _heading = degrees * Ghul.Math.pi / 180.0D
        si

        turn(degrees: double) is
            _heading = _heading + degrees * Ghul.Math.pi / 180.0D
        si

        // Lifts the pen, so moving leaves no line until `pen_down`.
        pen_up() is
            _drawing = false
        si

        pen_down() is
            _drawing = true
        si

        forward(distance: double) is
            let to_x = _x + distance * Ghul.Math.cos(_heading)
            let to_y = _y + distance * Ghul.Math.sin(_heading)

            if _drawing then
                _image.line(_x, _y, to_x, to_y)
            fi

            _x = to_x
            _y = to_y
        si
    si
si
