namespace Raster is
    use Collections.LIST
    use Ghul.Pipes
    use Math = System.Math

    // A truecolour image, drawn into with strokes and written as a PNG.
    //
    // Positions are in whatever coordinates `view` was given, so a program
    // works in the space its problem is stated in. Sizes are in pixels: a
    // label is as tall as it is asked to be however the axes are scaled, and
    // a stroke is as wide as it is asked to be.
    class IMAGE: Ghul.Renderable is
        width: int
        height: int

        _pixels: LIST[ubyte]

        // The transform from user coordinates to pixels, as the six numbers
        // of an affine map. Identity until `view` says otherwise, so a
        // program that thinks in pixels says nothing.
        _xx: double
        _xy: double
        _yx: double
        _yy: double
        _x0: double
        _y0: double

        _stroke: double

        _red: ubyte
        _green: ubyte
        _blue: ubyte

        init(width: int, height: int) is
            self.width = width
            self.height = height

            let white = System.GC.allocate_array[ubyte](width * height * 3, false)

            System.Array.fill(white, 255ub)

            _pixels = LIST[ubyte](white)

            _xx = 1.0D
            _xy = 0.0D
            _yx = 0.0D
            _yy = 1.0D
            _x0 = 0.0D
            _y0 = 0.0D

            _bounds = (
                left = 0.0D,
                bottom = cast double(height),
                right = cast double(width),
                top = 0.0D
            )

            _stroke = 1.0D

            _red = 0ub
            _green = 0ub
            _blue = 0ub
        si

        // Maps a rectangle of user coordinates onto the whole image, with y
        // increasing upwards as it does in mathematics rather than downwards
        // as it does in an image. The rectangle is mapped exactly, so it
        // stretches where its proportions differ from the image's.
        view(left: double, bottom: double, right: double, top: double) is
            view(left, bottom, right, top, 0.0D)
        si

        // The same, with a margin of its own on each side, in pixels.
        view(
            left: double, bottom: double, right: double, top: double,
            margins: (left: double, bottom: double, right: double, top: double)
        ) is
            _xx = (cast double(width) - margins.left - margins.right) / (right - left)
            _xy = 0.0D
            _yx = 0.0D
            _yy = -(cast double(height) - margins.bottom - margins.top) / (top - bottom)
            _x0 = margins.left - left * _xx
            _y0 = margins.top - top * _yy

            _bounds = (left = left, bottom = bottom, right = right, top = top)
        si

        // The same, onto the image less `margin` pixels on every side, which
        // leaves room outside the rectangle for axes and their labels.
        view(
            left: double, bottom: double, right: double, top: double,
            margin: double
        ) is
            _xx = (cast double(width) - 2.0D * margin) / (right - left)
            _xy = 0.0D
            _yx = 0.0D
            _yy = -(cast double(height) - 2.0D * margin) / (top - bottom)
            _x0 = margin - left * _xx
            _y0 = margin - top * _yy

            _bounds = (left = left, bottom = bottom, right = right, top = top)
        si

        // The rectangle the last `view` was given. Without one, it is the
        // image itself, in pixels, with its top at row zero.
        bounds: (left: double, bottom: double, right: double, top: double) =>
            _bounds

        _bounds: (left: double, bottom: double, right: double, top: double)

        stroke(width: double) is
            _stroke = width
        si

        colour(red: ubyte, green: ubyte, blue: ubyte) is
            _red = red
            _green = green
            _blue = blue
        si

        // The colour being drawn with.
        current_colour: (red: ubyte, green: ubyte, blue: ubyte) =>
            (red = _red, green = _green, blue = _blue)

        // A colour as a colour map gives it.
        colour(rgb: (red: ubyte, green: ubyte, blue: ubyte)) is
            colour(rgb.red, rgb.green, rgb.blue)
        si

        _to_pixel_x(x: double, y: double) -> double => _xx * x + _yx * y + _x0
        _to_pixel_y(x: double, y: double) -> double => _xy * x + _yy * y + _y0

        // Where a position falls on the image, which is what the view
        // decides. Useful to a caller placing something by hand, and the
        // only way to see that a view means what it says.
        to_pixel(x: double, y: double) -> (x: double, y: double) =>
            (x = _to_pixel_x(x, y), y = _to_pixel_y(x, y))

        // The position a pixel shows, which undoes `to_pixel`.
        to_user(x: double, y: double) -> (x: double, y: double) =>
            (let determinant = _xx * _yy - _xy * _yx
             let px = x - _x0
             let py = y - _y0

             (x = (_yy * px - _yx * py) / determinant,
              y = (_xx * py - _xy * px) / determinant))

        // What is at a pixel of the image, in pixels.
        pixel(x: int, y: int) -> (red: ubyte, green: ubyte, blue: ubyte) =>
            (let at = (y * width + x) * 3

             (red = _pixels[at],
              green = _pixels[at + 1],
              blue = _pixels[at + 2]))

        // Every pixel back to white, as a new image starts, so one image can
        // be drawn again frame after frame without allocating another.
        clear() is
            System.Runtime.InteropServices.CollectionsMarshal
                .as_span(_pixels)
                .fill(255ub)
        si

        // Every pixel set to one colour, for painting a background.
        clear(red: ubyte, green: ubyte, blue: ubyte) is
            let row = System.GC.allocate_array[ubyte](width * 3, false)

            for x in 0..width do
                System.MemoryExtensions.as_span(row, x * 3, 3).fill(red)
                System.MemoryExtensions.as_span(row, x * 3 + 1, 2).fill(green)
                System.MemoryExtensions.as_span(row, x * 3 + 2, 1).fill(blue)
            od

            let pixels = System.Runtime.InteropServices.CollectionsMarshal.as_span(_pixels)

            for y in 0..height do
                System.MemoryExtensions.as_span(row).copy_to(pixels.slice(y * width * 3))
            od
        si

        // A pixel set to the current colour outright.
        set_pixel(x: int, y: int) is
            set_pixel(x, y, _red, _green, _blue)
        si

        // A pixel of the image itself, in pixels, whatever the view says.
        set_pixel(x: int, y: int, red: ubyte, green: ubyte, blue: ubyte) is
            if x < 0 \/ y < 0 \/ x >= width \/ y >= height then
                return
            fi

            let at = (y * width + x) * 3

            _pixels[at] = red
            _pixels[at + 1] = green
            _pixels[at + 2] = blue
        si

        // Lays `weight` of the current colour over what is already
        // there, so a program drawing its own shapes can antialias them
        // rather than choosing a pixel colour outright. A position off
        // the image is ignored, as it is for `set_pixel`.
        blend(x: int, y: int, weight: double) is
            if x < 0 \/ y < 0 \/ x >= width \/ y >= height \/ weight <= 0.0D then
                return
            fi

            let covered = if weight > 1.0D then 1.0D else weight fi
            let at = (y * width + x) * 3

            _pixels[at] = _mix(_pixels[at], _red, covered)
            _pixels[at + 1] = _mix(_pixels[at + 1], _green, covered)
            _pixels[at + 2] = _mix(_pixels[at + 2], _blue, covered)
        si

        _mix(under: ubyte, over: ubyte, weight: double) -> ubyte =>
            cast ubyte(
                cast double(under) * (1.0D - weight) +
                cast double(over) * weight + 0.5D
            )

        // How far a point lies from a segment, which is what makes a stroke a
        // capsule: the ends are round because the distance is measured to the
        // segment rather than to the line through it, and so are the joins
        // where one stroke meets the next.
        _distance(
            x: double, y: double,
            x0: double, y0: double,
            x1: double, y1: double
        ) -> double =>
            (let dx = x1 - x0
             let dy = y1 - y0
             let square = dx * dx + dy * dy

             let along =
                 if square <= 0.0D then
                     0.0D
                 else
                     (let t = ((x - x0) * dx + (y - y0) * dy) / square

                      if t < 0.0D then 0.0D elif t > 1.0D then 1.0D else t fi)
                 fi

             let near_x = x0 + along * dx
             let near_y = y0 + along * dy

             Math.sqrt((x - near_x) * (x - near_x) + (y - near_y) * (y - near_y)))

        line(x0: double, y0: double, x1: double, y1: double) is
            _stroke_pixels(
                _to_pixel_x(x0, y0), _to_pixel_y(x0, y0),
                _to_pixel_x(x1, y1), _to_pixel_y(x1, y1),
                _stroke
            )
        si

        // A line through each point in turn, with the joins rounded the
        // same way a single stroke's ends are. The shape is left open: to
        // close it, repeat the first point.
        line(points: Collections.List[(x: double, y: double)]) is
            for at in 0..points.count - 1 do
                line(
                    points[at].x, points[at].y,
                    points[at + 1].x, points[at + 1].y
                )
            od
        si

        // How many rows are sampled within each pixel row of a fill. Four
        // is enough for an edge to read as a straight line rather than as
        // a staircase, at four times the work of none.
        _SAMPLES: int static => 4

        // The polygon these points enclose, filled with the current
        // colour. The last point joins the first, so a shape need not
        // repeat it, and a boundary crossed twice leaves a hole.
        fill(points: Collections.List[(x: double, y: double)]) is
            if points.count < 3 then
                return
            fi

            let xs =
                (0..points.count)
                    |> map(at => _to_pixel_x(points[at].x, points[at].y))
                    |> collect()

            let ys =
                (0..points.count)
                    |> map(at => _to_pixel_y(points[at].x, points[at].y))
                    |> collect()

            let top = _clamp(ys |> reduce(ys[0], _least), 0, height)
            let bottom = _clamp(ys |> reduce(ys[0], _most) + 1.0D, 0, height)

            let coverage = (0..width) |> map(_ => 0.0D) |> collect_mutable()

            for y in top..bottom do
                // Only the columns between the outermost crossings can be
                // covered, so only those are cleared and blended.
                let first mut = width
                let last mut = 0

                for sample in 0.._SAMPLES do
                    let at =
                        cast double(y) +
                        (cast double(sample) + 0.5D) / cast double(_SAMPLES)

                    let crossings = _crossings(xs, ys, at)

                    if crossings.count >= 2 then
                        first = Math.min(first, _clamp(crossings[0], 0, width))
                        last = Math.max(last, _clamp(crossings[crossings.count - 1] + 1.0D, 0, width))
                    fi

                    let index mut = 0

                    while index + 1 < crossings.count do
                        _cover(
                            coverage, crossings[index], crossings[index + 1]
                        )

                        index = index + 2
                    od
                od

                for x in first..last do
                    blend(x, y, coverage[x] / cast double(_SAMPLES))

                    coverage[x] = 0.0D
                od
            od
        si

        _least(a: double, b: double) -> double static =>
            if a < b then a else b fi

        _most(a: double, b: double) -> double static =>
            if a > b then a else b fi

        _clamp(value: double, low: int, high: int) -> int static =>
            (let at = cast int(Math.floor(value))

             if at < low then low elif at > high then high else at fi)

        // Where the outline crosses this row, in order along it. The
        // pairs between them are what lies inside.
        _crossings(
            xs: double[], ys: double[], at: double
        ) -> Collections.List[double] static is
            let found = LIST[double]()

            for first in 0..xs.count do
                let second = (first + 1) % xs.count

                if (ys[first] <= at) != (ys[second] <= at) then
                    found.add(
                        xs[first] +
                        (at - ys[first]) / (ys[second] - ys[first]) *
                        (xs[second] - xs[first])
                    )
                fi
            od

            found.sort()

            return found
        si

        // Adds what this span covers of each pixel it touches, so an edge
        // part way across one counts for part of it.
        _cover(coverage: LIST[double], from: double, to: double) is
            let left = if from < 0.0D then 0.0D else from fi
            let right =
                if to > cast double(width) then cast double(width) else to fi

            if right <= left then
                return
            fi

            for x in cast int(Math.floor(left))..cast int(Math.ceiling(right)) do
                let within =
                    _least(right, cast double(x + 1)) -
                    _most(left, cast double(x))

                if within > 0.0D then
                    coverage[x] = coverage[x] + within
                fi
            od
        si

        // Every pixel joined to this one and the colour it is, recoloured.
        // Positions are pixels, as they are for `set_pixel`: the region is
        // a property of the image rather than of what the view describes.
        flood_fill(x: int, y: int) is
            if x < 0 \/ y < 0 \/ x >= width \/ y >= height then
                return
            fi

            let start = pixel(x, y)

            if start =~ (red = _red, green = _green, blue = _blue) then
                return
            fi

            let pending = Collections.STACK[(x: int, y: int)]()

            pending.push((x = x, y = y))

            while pending.count > 0 do
                let at = pending.pop()

                if at.x >= 0 /\ at.y >= 0 /\
                    at.x < width /\ at.y < height /\
                    pixel(at.x, at.y) =~ start
                then
                    set_pixel(at.x, at.y, _red, _green, _blue)

                    pending.push((x = at.x + 1, y = at.y))
                    pending.push((x = at.x - 1, y = at.y))
                    pending.push((x = at.x, y = at.y + 1))
                    pending.push((x = at.x, y = at.y - 1))
                fi
            od
        si

        // Names an image this program wrote, at the point in the output
        // where it belongs.
        //
        // A console program that draws has two outputs, and nothing in the
        // text says where the pictures go. This writes a marker that says
        // so, for whatever is displaying the output to interpret: a
        // publisher can turn it into a reference the destination understands,
        // and a console that can show images can show it in place. Programs
        // that are only read on a terminal lose nothing, since the marker
        // names the file they were told about anyway.
        show(path: string) is
            IO.Std.write_line("<<image {path}>>")
        si

        // Text with its baseline at (x, y) in user coordinates, `height`
        // pixels from baseline to the top of a capital. The weight follows
        // the height, since a stroke font carries none of its own.
        text(x: double, y: double, height: double, letters: string) is
            text(x, y, height, height / 10.0D, letters)
        si

        text(
            x: double,
            y: double,
            height: double,
            weight: double,
            letters: string
        ) is
            text(x, y, height, weight, letters, Anchor.LEFT)
        si

        // Text whose baseline starts, is centred, or ends at (x, y), as
        // `anchor` says.
        text(
            x: double,
            y: double,
            height: double,
            letters: string,
            anchor: Anchor
        ) is
            text(x, y, height, height / 10.0D, letters, anchor)
        si

        text(
            x: double,
            y: double,
            height: double,
            weight: double,
            letters: string,
            anchor: Anchor
        ) is
            _letters(
                _to_pixel_x(x, y), _to_pixel_y(x, y),
                height, weight, letters, anchor, false
            )
        si

        // Text reading upwards, turned a quarter counter-clockwise, as a
        // label beside a vertical axis is. Its baseline runs through (x, y)
        // with the tops of the letters to the left of it.
        upward_text(
            x: double,
            y: double,
            height: double,
            letters: string,
            anchor: Anchor
        ) is
            _letters(
                _to_pixel_x(x, y), _to_pixel_y(x, y),
                height, height / 10.0D, letters, anchor, true
            )
        si

        _letters(
            x: double,
            y: double,
            height: double,
            weight: double,
            letters: string,
            anchor: Anchor,
            upward: bool
        ) is
            let font = FONT.simplex
            let scale = height / FONT.CAP_HEIGHT

            let along mut =
                case anchor
                when Anchor.LEFT then 0.0D
                when Anchor.CENTRE then -text_width(height, letters) / 2.0D
                when Anchor.RIGHT then -text_width(height, letters)
                esac

            for letter in letters do
                if let glyph = font.glyph(letter) then
                    for stroke in glyph.strokes do
                        for at in 0..stroke.count - 1 do
                            let from = _place(
                                x, y, upward,
                                along + cast double(stroke[at].x - glyph.left) * scale,
                                (cast double(stroke[at].y) - FONT.BASELINE) * scale
                            )

                            let to = _place(
                                x, y, upward,
                                along + cast double(stroke[at + 1].x - glyph.left) * scale,
                                (cast double(stroke[at + 1].y) - FONT.BASELINE) * scale
                            )

                            _stroke_pixels(from.x, from.y, to.x, to.y, weight)
                        od
                    od

                    along = along + cast double(glyph.width) * scale
                fi
            od
        si

        // Where a point of a letter lands, given how far it is along the
        // baseline and how far below it.
        _place(
            x: double, y: double, upward: bool, along: double, below: double
        ) -> (x: double, y: double) static =>
            if upward then
                (x = x + below, y = y - along)
            else
                (x = x + along, y = y + below)
            fi

        // How wide that text will be, in pixels, so a caller can place it.
        text_width(height: double, letters: string) -> double =>
            (let font = FONT.simplex
             let scale = height / FONT.CAP_HEIGHT

             let total mut = 0.0D

             for letter in letters do
                 if let glyph = font.glyph(letter) then
                     total = total + cast double(glyph.width) * scale
                 fi
             od

             total)

        // The image as a PNG: signature, header, one block of image data and
        // an end marker. Each scanline carries filter byte 0, so what is
        // compressed is the pixels as they stand.
        write(path: string) is
            IO.File.write_all_bytes(path, encode())
        si

        // The bytes `write` would put in a file, for a caller with somewhere
        // else to send them.
        encode() -> ubyte[] =>
            (let out = IO.MemoryStream()

             _PNG.write_start(out, width, height)
             _PNG.write_chunk(out, _PNG.IDAT, _PNG.compress(rgb(), width, height))
             _PNG.write_chunk(out, _PNG.IEND, [])

             out.to_array())

        // The image as a PNG, for a host that shows values - a notebook,
        // a REPL - to show in place of the text `$` writes for it.
        representations() -> Collections.Iterable[(mime: string, content: ubyte[])] pure =>
            [(mime = "image/png", content = encode())]

        // An image holding these pixels, laid out as `rgb` gives them.
        from_rgb(width: int, height: int, rgb: ubyte[]) -> IMAGE static is
            if rgb.count != width * height * 3 then
                throw System.ArgumentException(
                    "{rgb.count} bytes are not a {width} by {height} image"
                )
            fi

            let image = IMAGE(width, height)

            image._pixels = LIST[ubyte](rgb)

            return image
        si

        // A copy of the pixels, three bytes each for red, green and blue, a
        // row at a time from the top.
        rgb() -> ubyte[] =>
            (let copy = System.GC.allocate_array[ubyte](_pixels.count, false)

             _pixels.copy_to(copy)

             copy)

        // Everything is drawn as strokes, so this is the only place pixels
        // are touched by a drawing operation.
        _stroke_pixels(
            x0: double, y0: double,
            x1: double, y1: double,
            weight: double
        ) is
            let half = weight / 2.0D
            let reach = half + 1.0D

            let left = cast int(Math.floor(Math.min(x0, x1) - reach))
            let right = cast int(Math.ceiling(Math.max(x0, x1) + reach))
            let top = cast int(Math.floor(Math.min(y0, y1) - reach))
            let bottom = cast int(Math.ceiling(Math.max(y0, y1) + reach))

            // A short stroke, such as one of a letter's, is quicker to scan
            // whole than to work out the span of each row.
            let narrow = right - left <= 16

            for y in top::bottom do
                let row =
                    if narrow then
                        (from = cast double(left), to = cast double(right))
                    else
                        _stroke_row(cast double(y) + 0.5D, x0, y0, x1, y1, half + 0.5D)
                    fi

                if row.from > row.to then
                    continue
                fi

                let first =
                    Math.max(left, cast int(Math.floor(Math.max(row.from, cast double(left)))) - 1)
                let last =
                    Math.min(right, cast int(Math.ceiling(Math.min(row.to, cast double(right)))) + 1)

                for x in first::last do
                    let away =
                        _distance(
                            cast double(x) + 0.5D,
                            cast double(y) + 0.5D,
                            x0, y0, x1, y1
                        )

                    blend(x, y, half + 0.5D - away)
                od
            od
        si

        // A span widened by where the row crosses the circle round one end.
        _end_row(
            y: double, x: double, end_y: double, limit: double,
            span: (from: double, to: double)
        ) -> (from: double, to: double) static =>
            (let off = y - end_y

             if Math.abs(off) < limit then
                 (let across = Math.sqrt(limit * limit - off * off)

                  (from = Math.min(span.from, x - across),
                   to = Math.max(span.to, x + across)))
             else
                 span
             fi)

        // Where a row crosses the capsule of points nearer the segment than
        // `limit`, so a stroke visits the pixels it can cover rather than its
        // whole bounding box. The capsule is convex, so the crossing is one
        // span: the widest of what the two end circles and the band between
        // them contribute. A pixel is only skipped if it lies outside the span
        // by more than a pixel, and so would have been given no cover anyway.
        _stroke_row(
            y: double,
            x0: double, y0: double,
            x1: double, y1: double,
            limit: double
        ) -> (from: double, to: double) static =>
            (let ends =
                 _end_row(y, x1, y1, limit, _end_row(y, x0, y0, limit, (from = 1.0e300D, to = -1.0e300D)))

             let from mut = ends.from
             let to mut = ends.to

             let dx = x1 - x0
             let dy = y1 - y0
             let square = dx * dx + dy * dy

             if square > 0.0D then
                 let length = Math.sqrt(square)
                 let off = y - y0

                 let band =
                     if dy != 0.0D then
                         (let a = x0 + (off * dx - limit * length) / dy
                          let b = x0 + (off * dx + limit * length) / dy

                          (from = Math.min(a, b), to = Math.max(a, b)))
                     elif Math.abs(off * dx) / length < limit then
                         (from = -1.0e300D, to = 1.0e300D)
                     else
                         (from = 1.0e300D, to = -1.0e300D)
                     fi

                 let slab =
                     if dx != 0.0D then
                         (let a = x0 - off * dy / dx
                          let b = x0 + (square - off * dy) / dx

                          (from = Math.min(a, b), to = Math.max(a, b)))
                     elif off * dy >= 0.0D /\ off * dy <= square then
                         (from = -1.0e300D, to = 1.0e300D)
                     else
                         (from = 1.0e300D, to = -1.0e300D)
                     fi

                 let inside_from = Math.max(band.from, slab.from)
                 let inside_to = Math.min(band.to, slab.to)

                 if inside_from <= inside_to then
                     from = Math.min(from, inside_from)
                     to = Math.max(to, inside_to)
                 fi
             fi

             (from = from, to = to))
    si
si
