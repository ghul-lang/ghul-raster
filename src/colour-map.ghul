namespace Raster is

    // Colours for values, each map taking a number from 0 to 1 to a colour
    // `IMAGE.colour` accepts, so a heat map colours every cell alike rather
    // than inventing a ramp of its own.
    class COLOUR_MAP is
        // Dark blue through green to yellow, getting steadily lighter, for a
        // value that only grows: a count, a distance, an intensity. Values
        // outside 0 to 1 take the colour of the end they are beyond.
        viridis(value: double) -> (red: ubyte, green: ubyte, blue: ubyte) static =>
            _between(
                [
                    (68, 1, 84), (71, 44, 122), (59, 81, 139),
                    (44, 113, 142), (33, 144, 141), (39, 173, 129),
                    (92, 200, 99), (170, 220, 50), (253, 231, 37)
                ],
                value
            )

        // Blue through pale grey to red, for a value either side of a middle
        // that means nothing in particular: a difference, a correlation. The
        // middle is 0.5, so a range centred on zero is shifted and halved
        // before it is looked up. Values outside 0 to 1 are clamped.
        cool_warm(value: double) -> (red: ubyte, green: ubyte, blue: ubyte) static =>
            _between(
                [
                    (59, 76, 192), (98, 130, 234), (141, 176, 254),
                    (184, 208, 249), (221, 221, 221), (245, 196, 173),
                    (244, 154, 123), (222, 96, 77), (180, 4, 38)
                ],
                value
            )

        // Fully saturated colour around the colour wheel, red at 0 and back
        // to red at 1, for a value that wraps: an angle, a phase, a
        // remainder. A value outside 0 to 1 wraps round the wheel with it.
        hue(value: double) -> (red: ubyte, green: ubyte, blue: ubyte) static =>
            (let turn = value - Ghul.Math.floor(value)
             let sixths = turn * 6.0D
             let sector = cast int(Ghul.Math.floor(sixths)) % 6
             let rising = sixths - Ghul.Math.floor(sixths)
             let falling = 1.0D - rising

             case sector
             when 0 then _rgb(1.0D, rising, 0.0D)
             when 1 then _rgb(falling, 1.0D, 0.0D)
             when 2 then _rgb(0.0D, 1.0D, rising)
             when 3 then _rgb(0.0D, falling, 1.0D)
             when 4 then _rgb(rising, 0.0D, 1.0D)
             else _rgb(1.0D, 0.0D, falling)
             esac)

        _rgb(
            red: double, green: double, blue: double
        ) -> (red: ubyte, green: ubyte, blue: ubyte) static =>
            (red = _channel(red * 255.0D),
             green = _channel(green * 255.0D),
             blue = _channel(blue * 255.0D))

        _channel(value: double) -> ubyte static =>
            if value <= 0.0D then
                0ub
            elif value >= 255.0D then
                255ub
            else
                cast ubyte(value + 0.5D)
            fi

        // Evenly spaced colours, with the space between each pair filled by
        // mixing its ends.
        _between(
            stops: (int, int, int)[], value: double
        ) -> (red: ubyte, green: ubyte, blue: ubyte) static =>
            (let clamped =
                 if !(value > 0.0D) then 0.0D elif value > 1.0D then 1.0D else value fi

             let position = clamped * cast double(stops.count - 1)
             let below = cast int(Ghul.Math.floor(position))
             let at = if below >= stops.count - 1 then stops.count - 2 else below fi
             let part = position - cast double(at)

             let low = stops[at]
             let high = stops[at + 1]

             (red = _channel(_mix(low.`0, high.`0, part)),
              green = _channel(_mix(low.`1, high.`1, part)),
              blue = _channel(_mix(low.`2, high.`2, part))))

        _mix(low: int, high: int, part: double) -> double static =>
            cast double(low) + (cast double(high - low)) * part
    si
si
