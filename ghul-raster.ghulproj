<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>

    <Title>ghūl raster graphics</Title>
    <PackageId>ghul.raster</PackageId>
    <Authors>degory</Authors>
    <Description>Drawing into a PNG from ghūl: antialiased strokes and circles, an affine view, axes, colour maps and stroke-font text, in managed code with no native dependency</Description>
    <PackageDescription>Drawing into a PNG from ghūl: antialiased strokes and circles, an affine view, axes, colour maps and stroke-font text, in managed code with no native dependency</PackageDescription>
    <PackageTags>ghul;ghūl;graphics;png;raster;plotting</PackageTags>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <PackageProjectUrl>https://ghul.dev</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ghul-lang/ghul-raster</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>main</RepositoryBranch>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <PackageIcon>ghul-logo-icon.png</PackageIcon>

    <GhulCompiler>dotnet ghul-compiler</GhulCompiler>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE*" Pack="true" PackagePath="\" />

    <None Include="./images/ghul-logo-icon.png" Pack="true" PackagePath="" />

    <GhulSources Include="src/**/*.ghul" />
  </ItemGroup>
</Project>
