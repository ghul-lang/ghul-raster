use System.Math
use Ghul.Pipes
use Raster.AXES
use Raster.COLOUR_MAP
use Raster.IMAGE
use Raster.SHAPES

// A bar chart of leading digits, with one labelled tick for each digit,
// bars filled together so neighbours meet without a seam, round markers on
// an unequally scaled view, and a key; then a strip of triangles tiled
// together below a background colour.
let image = IMAGE(360, 260)

image.clear(250ub, 248ub, 240ub)

let axes = AXES(image)

axes.x_title = "leading digit"
axes.y_title = "share"
axes.x_ticks((1::9) |> map(digit => (value = cast double(digit), label = "{digit}")) |> collect_mutable())
axes.key("counted", 90ub, 120ub, 200ub)
axes.key("Benford", 200ub, 60ub, 60ub)
axes.fit(0.5D, -0.02D, 9.5D, 0.32D)

let bars = SHAPES()

for digit in 1::9 do
    let share = 0.3D / cast double(digit)
    let left = cast double(digit) - 0.5D

    bars.add(
        [(x = left, y = 0.0D), (x = left + 1.0D, y = 0.0D),
         (x = left + 1.0D, y = share), (x = left, y = share)],
        COLOUR_MAP.viridis(cast double(digit) / 10.0D)
    )
od

image.fill(bars)

image.colour(200ub, 60ub, 60ub)

for digit in 1::9 do
    image.dot(cast double(digit), Math.log10(1.0D + 1.0D / cast double(digit)), 3.5D)
od

image.colour(30ub, 30ub, 30ub)
image.stroke(1.0D)
image.ring(5.0D, 0.25D, 6.0D)
image.set_pixel(0, 0)

axes.draw()

image.write("chart.png")
image.show("chart.png")

let strip = IMAGE(200, 40)
let tiles = SHAPES()

for index in 0..10 do
    let x = cast double(index) * 20.0D

    tiles.add([(x = x, y = 0.0D), (x = x + 20.0D, y = 0.0D), (x = x, y = 40.0D)], COLOUR_MAP.hue(cast double(index) / 10.0D))
    tiles.add([(x = x + 20.0D, y = 0.0D), (x = x + 20.0D, y = 40.0D), (x = x, y = 40.0D)], COLOUR_MAP.hue(cast double(index) / 10.0D))
od

strip.fill(tiles)

strip.write("strip.png")
strip.show("strip.png")
