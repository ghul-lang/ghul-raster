use Ghul.Math
use Raster.IMAGE

// Everything the library does, in one picture: a view in the coordinates the
// problem is stated in, strokes of two weights, and text placed against the
// axis it labels.
let image = IMAGE(320, 200)

image.view(-0.5D, -1.4D, 6.8D, 1.4D)

image.color(200ub, 200ub, 200ub)
image.stroke(1.0D)

for n in 0::6 do
    image.line(cast double(n), -1.2D, cast double(n), 1.2D)
od

image.color(120ub, 120ub, 120ub)
image.line(-0.3D, 0.0D, 6.6D, 0.0D)

image.color(20ub, 60ub, 200ub)
image.stroke(2.0D)

let steps = 200

for at in 0..steps do
    let x0 = 6.5D * cast double(at) / cast double(steps)
    let x1 = 6.5D * cast double(at + 1) / cast double(steps)

    image.line(x0, Ghul.Math.sin(x0), x1, Ghul.Math.sin(x1))
od

image.color(0ub, 0ub, 0ub)
image.text(0.1D, 1.15D, 14.0D, "sin x")

image.write("plot.png")
image.show("plot.png")
