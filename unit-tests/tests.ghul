namespace Raster.Tests is
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Ghul.Pipes
    use Math = System.Math

    entry()

    @TestClass()
    class FONT_Tests is
        init() is si

        @Test()
        The_simplex_face_covers_printable_ASCII() is
            let font = FONT.simplex

            for at in 32::126 do
                assert font.glyph(cast char(at))?
                    else "no glyph for character {at}"
            od
        si

        @Test()
        A_capital_sits_on_the_baseline_and_is_as_tall_as_asked() is
            let image = IMAGE(100, 100)

            image.colour(0ub, 0ub, 0ub)
            image.text(20.0D, 70.0D, 40.0D, 0.5D, "H")

            let rows =
                (0..100)
                    |> filter(y =>
                        (0..100)
                            |> filter(x =>
                                image.pixel(x, y) !~
                                    (red = 255ub, green = 255ub, blue = 255ub))
                            |> count() > 0)
                    |> collect()

            assert rows[0] >= 29 /\ rows[0] <= 30 else "top at {rows[0]}"
            assert rows[rows.count - 1] >= 69 /\ rows[rows.count - 1] <= 70
                else "bottom at {rows[rows.count - 1]}"
        si

        @Test()
        A_space_is_blank_but_has_width() is
            let space = FONT.simplex.glyph(' ')

            assert space?
            assert space.strokes.count == 0
            assert space.width > 0
        si

        @Test()
        A_letter_is_drawn_from_strokes_of_at_least_two_points() is
            let letter = FONT.simplex.glyph('A')

            assert letter?
            assert letter.strokes.count > 0

            for stroke in letter.strokes do
                assert stroke.count >= 2 else "a stroke of one point draws nothing"
            od
        si
    si

    @TestClass()
    class READ_Tests is
        init() is si

        @Test()
        An_image_reads_back_as_it_was_written() is
            let written = IMAGE(30, 20)

            written.colour(10ub, 90ub, 200ub)
            written.stroke(3.0D)
            written.line(2.0D, 2.0D, 27.0D, 17.0D)

            let path = IO.Path.get_temp_file_name()

            written.write(path)

            let read = IMAGE.read(path)

            IO.File.delete(path)

            assert read.width == written.width
            assert read.height == written.height

            for y in 0..written.height do
                for x in 0..written.width do
                    assert read.pixel(x, y) =~ written.pixel(x, y)
                        else "{x}, {y} came back different"
                od
            od
        si

        @Test()
        Grey_reads_as_the_same_value_in_every_channel() is
            let image = IMAGE.read("images/grey.png")

            assert image.pixel(0, 0) =~ (red = 0ub, green = 0ub, blue = 0ub)
            assert image.pixel(1, 0) =~ (red = 64ub, green = 64ub, blue = 64ub)
            assert image.pixel(0, 1) =~
                (red = 128ub, green = 128ub, blue = 128ub)
            assert image.pixel(1, 1) =~
                (red = 255ub, green = 255ub, blue = 255ub)
        si

        @Test()
        An_index_reads_as_its_palette_entry() is
            let image = IMAGE.read("images/indexed.png")

            assert image.pixel(0, 0) =~ (red = 255ub, green = 0ub, blue = 0ub)
            assert image.pixel(1, 0) =~ (red = 0ub, green = 255ub, blue = 0ub)
            assert image.pixel(0, 1) =~ (red = 0ub, green = 0ub, blue = 255ub)
        si

        @Test()
        Alpha_is_composited_onto_the_white_an_image_starts_as() is
            let image = IMAGE.read("images/translucent.png")

            assert image.pixel(0, 0) =~ (red = 255ub, green = 0ub, blue = 0ub)
                else "an opaque pixel changed"

            let half = image.pixel(1, 0)

            assert half.green > 100ub /\ half.green < 160ub
                else "half cover did not land between the colour and white"

            assert image.pixel(0, 1) =~
                (red = 255ub, green = 255ub, blue = 255ub)
                else "a transparent pixel is not white"
        si
    si

    @TestClass()
    class TURTLE_Tests is
        init() is si

        @Test()
        A_turtle_starts_at_the_origin_facing_along_x() is
            let turtle = TURTLE(IMAGE(10, 10))

            assert turtle.x =~ 0.0D
            assert turtle.y =~ 0.0D
            assert turtle.heading =~ 0.0D
        si

        @Test()
        Going_forward_moves_the_way_it_is_facing() is
            let turtle = TURTLE(IMAGE(40, 40))

            turtle.move_to(10.0D, 10.0D)
            turtle.face(90.0D)
            turtle.forward(5.0D)

            assert Math.abs(turtle.x - 10.0D) < 0.000001D
            assert Math.abs(turtle.y - 15.0D) < 0.000001D
        si

        @Test()
        Turns_accumulate() is
            let turtle = TURTLE(IMAGE(10, 10))

            turtle.turn(90.0D)
            turtle.turn(45.0D)

            assert Math.abs(turtle.heading - 135.0D) < 0.000001D
        si

        @Test()
        A_lifted_pen_moves_without_drawing() is
            let drawn = IMAGE(40, 40)
            let skipped = IMAGE(40, 40)

            for image in [drawn, skipped] do
                image.colour(0ub, 0ub, 0ub)
            od

            let drawing = TURTLE(drawn)
            let lifted = TURTLE(skipped)

            lifted.pen_up()

            for turtle in [drawing, lifted] do
                turtle.move_to(5.0D, 20.0D)
                turtle.forward(30.0D)
            od

            assert _marked(drawn, 20, 20)
                else "the drawing turtle left no line"
            assert !_marked(skipped, 20, 20)
                else "the lifted turtle drew anyway"

            assert Math.abs(lifted.x - 35.0D) < 0.000001D
                else "the lifted turtle did not move"
        si

        _marked(image: IMAGE, x: int, y: int) -> bool =>
            image.pixel(x, y) !~ (red = 255ub, green = 255ub, blue = 255ub)
    si

    @TestClass()
    class IMAGE_Tests is
        init() is si

        // The pixel an image starts as, so a test can say what changed.
        _white(image: IMAGE, x: int, y: int) -> bool =>
            image.pixel(x, y) =~ (red = 255ub, green = 255ub, blue = 255ub)

        @Test()
        A_new_image_is_white() is
            let image = IMAGE(4, 3)

            for y in 0..3 do
                for x in 0..4 do
                    assert _white(image, x, y) else "{x}, {y} is not white"
                od
            od
        si

        @Test()
        A_view_puts_the_origin_where_it_says() is
            let image = IMAGE(100, 100)

            // y increases upwards, so the top of the range is row zero.
            image.view(0.0D, 0.0D, 10.0D, 10.0D)

            assert image.to_pixel(0.0D, 10.0D) =~ (x = 0.0D, y = 0.0D)
            assert image.to_pixel(10.0D, 0.0D) =~ (x = 100.0D, y = 100.0D)
            assert image.to_pixel(5.0D, 5.0D) =~ (x = 50.0D, y = 50.0D)
        si

        @Test()
        Without_a_view_a_position_is_already_a_pixel() is
            let image = IMAGE(20, 20)

            assert image.to_pixel(3.0D, 7.0D) =~ (x = 3.0D, y = 7.0D)
        si

        @Test()
        A_stroke_covers_its_own_line_and_stops() is
            let image = IMAGE(40, 40)

            image.colour(0ub, 0ub, 0ub)
            image.stroke(2.0D)
            image.line(5.0D, 20.0D, 35.0D, 20.0D)

            assert !_white(image, 20, 20) else "the line did not draw"
            assert _white(image, 20, 5) else "ink far above the line"
            assert _white(image, 20, 35) else "ink far below the line"
            assert _white(image, 1, 20) else "ink beyond the start"
        si

        @Test()
        A_thicker_stroke_covers_more() is
            let thin = IMAGE(40, 40)
            let thick = IMAGE(40, 40)

            for image in [thin, thick] do
                image.colour(0ub, 0ub, 0ub)
            od

            thin.stroke(1.0D)
            thick.stroke(5.0D)

            thin.line(5.0D, 20.0D, 35.0D, 20.0D)
            thick.line(5.0D, 20.0D, 35.0D, 20.0D)

            assert _inked(thick) > _inked(thin)
                else "a wider stroke marked no more pixels"
        si

        @Test()
        A_stroke_is_antialiased() is
            let image = IMAGE(40, 40)

            image.colour(0ub, 0ub, 0ub)
            image.stroke(1.0D)
            image.line(4.0D, 4.0D, 36.0D, 30.0D)

            let blended =
                (0..40)
                    |> map(y =>
                        (0..40)
                            |> filter(x =>
                                (let seen = image.pixel(x, y)

                                 seen.red > 0ub /\ seen.red < 255ub))
                            |> count())
                    |> reduce(0, (a, b) => a + b)

            assert blended > 0
                else "every pixel is either white or black, so nothing is blended"
        si

        _inked(image: IMAGE) -> int =>
            (0..image.height)
                |> map(y =>
                    (0..image.width)
                        |> filter(x =>
                            image.pixel(x, y) !~
                                (red = 255ub, green = 255ub, blue = 255ub))
                        |> count())
                |> reduce(0, (a, b) => a + b)

        @Test()
        A_blend_lays_part_of_the_colour_over_what_is_there() is
            let image = IMAGE(4, 4)

            image.colour(0ub, 0ub, 0ub)

            image.blend(1, 1, 0.5D)

            let half = image.pixel(1, 1)

            assert half.red > 0ub /\ half.red < 255ub
                else "half cover left the pixel white or black"

            image.blend(2, 2, 1.0D)

            assert image.pixel(2, 2) =~ (red = 0ub, green = 0ub, blue = 0ub)

            image.blend(3, 3, 0.0D)

            assert _white(image, 3, 3) else "no cover marked the pixel"
        si

        @Test()
        Clearing_an_image_makes_it_white_again() is
            let image = IMAGE(20, 20)

            image.colour(0ub, 0ub, 0ub)
            image.disc(10.0D, 10.0D, 8.0D)

            image.clear()

            assert _inked(image) == 0 else "ink survived the clear"
        si

        // A host that shows values - a notebook, a REPL - finds the image
        // as a PNG through the runtime's Renderable.
        @Test()
        An_image_offers_itself_as_a_png() is
            let image = IMAGE(30, 20)

            image.line(2.0D, 2.0D, 27.0D, 17.0D)

            let held: Ghul.Renderable = image
            let offered = Collections.LIST[(mime: string, content: ubyte[])](held.representations())

            assert offered.count == 1
            assert offered[0].mime =~ "image/png"
            assert IMAGE.decode(offered[0].content).pixel(15, 10) =~ image.pixel(15, 10)
        si

        @Test()
        Encoding_gives_the_bytes_a_write_would() is
            let image = IMAGE(30, 20)

            image.colour(10ub, 90ub, 200ub)
            image.line(2.0D, 2.0D, 27.0D, 17.0D)

            let path = IO.Path.get_temp_file_name()

            image.write(path)

            let written = IO.File.read_all_bytes(path)

            IO.File.delete(path)

            let encoded = image.encode()

            assert encoded.count == written.count

            for at in 0..encoded.count do
                assert encoded[at] == written[at] else "byte {at} differs"
            od

            assert IMAGE.decode(encoded).pixel(15, 10) =~ image.pixel(15, 10)
        si

        @Test()
        A_blend_outside_the_image_is_ignored() is
            let image = IMAGE(2, 2)

            image.colour(0ub, 0ub, 0ub)

            image.blend(-1, 0, 1.0D)
            image.blend(0, 5, 1.0D)

            for y in 0..2 do
                for x in 0..2 do
                    assert _white(image, x, y) else "{x}, {y} was marked"
                od
            od
        si

        @Test()
        A_filled_shape_is_solid_inside_and_clear_outside() is
            let image = IMAGE(60, 60)

            image.colour(0ub, 0ub, 0ub)

            image.fill([
                (x = 10.0D, y = 10.0D),
                (x = 50.0D, y = 10.0D),
                (x = 50.0D, y = 50.0D),
                (x = 10.0D, y = 50.0D)
            ])

            assert !_white(image, 30, 30) else "the middle is not filled"
            assert _white(image, 5, 30) else "ink outside the shape"
            assert _white(image, 55, 30) else "ink outside the shape"
        si

        @Test()
        A_shape_of_fewer_than_three_points_encloses_nothing() is
            let image = IMAGE(20, 20)

            image.colour(0ub, 0ub, 0ub)

            image.fill([(x = 2.0D, y = 2.0D), (x = 18.0D, y = 18.0D)])

            assert _inked(image) == 0 else "two points enclosed something"
        si

        @Test()
        A_line_through_points_joins_each_to_the_next() is
            let image = IMAGE(60, 60)

            image.colour(0ub, 0ub, 0ub)
            image.stroke(2.0D)

            image.line([
                (x = 10.0D, y = 10.0D),
                (x = 50.0D, y = 10.0D),
                (x = 50.0D, y = 50.0D)
            ])

            assert !_white(image, 30, 10) else "the first leg is missing"
            assert !_white(image, 50, 30) else "the second leg is missing"
            assert _white(image, 30, 50)
                else "the shape closed itself, which it should not"
        si

        @Test()
        A_flood_fill_stops_at_a_boundary() is
            let image = IMAGE(40, 40)

            image.colour(0ub, 0ub, 0ub)
            image.stroke(2.0D)

            image.line([
                (x = 8.0D, y = 8.0D),
                (x = 32.0D, y = 8.0D),
                (x = 32.0D, y = 32.0D),
                (x = 8.0D, y = 32.0D),
                (x = 8.0D, y = 8.0D)
            ])

            image.colour(200ub, 0ub, 0ub)

            image.flood_fill(20, 20)

            assert image.pixel(20, 20) =~
                (red = 200ub, green = 0ub, blue = 0ub)
                else "inside was not filled"

            assert _white(image, 2, 2) else "the fill escaped the boundary"
        si

        @Test()
        Text_is_as_wide_as_it_says_and_grows_with_its_height() is
            let image = IMAGE(10, 10)

            assert image.text_width(20.0D, "") =~ 0.0D

            let small = image.text_width(10.0D, "sin x")
            let large = image.text_width(20.0D, "sin x")

            assert small > 0.0D
            assert large > small
        si

        @Test()
        Text_draws_where_it_was_put() is
            let image = IMAGE(120, 60)

            image.colour(0ub, 0ub, 0ub)
            image.text(10.0D, 40.0D, 24.0D, "Ag")

            assert _inked(image) > 0 else "nothing was drawn"
            assert _white(image, 110, 55) else "ink far from the text"
        si
    si

    @TestClass()
    class CIRCLE_Tests is
        init() is si

        _white(image: IMAGE, x: int, y: int) -> bool =>
            image.pixel(x, y) =~ (red = 255ub, green = 255ub, blue = 255ub)

        _black(image: IMAGE, x: int, y: int) -> bool =>
            image.pixel(x, y) =~ (red = 0ub, green = 0ub, blue = 0ub)

        _image() -> IMAGE =>
            (let image = IMAGE(60, 60)

             image.colour(0ub, 0ub, 0ub)
             image.stroke(2.0D)

             image)

        @Test()
        A_disc_is_solid_inside_and_clear_outside() is
            let image = _image()

            image.disc(30.0D, 30.0D, 10.0D)

            assert _black(image, 30, 30) else "the centre is not filled"
            assert _black(image, 36, 30) else "inside the edge is not filled"
            assert _white(image, 30, 45) else "ink outside the disc"
        si

        @Test()
        A_circle_marks_its_edge_and_leaves_its_middle() is
            let image = _image()

            image.circle(30.0D, 30.0D, 10.0D)

            assert _white(image, 30, 30) else "the circle filled its middle"
            assert !_white(image, 39, 30) else "the edge is missing"
            assert !_white(image, 30, 20) else "the edge is missing"
            assert _white(image, 30, 45) else "ink outside the circle"
        si

        @Test()
        A_radius_is_in_user_coordinates() is
            let image = _image()

            image.view(0.0D, 0.0D, 6.0D, 6.0D)
            image.disc(3.0D, 3.0D, 1.0D)

            assert _black(image, 36, 30) else "a radius of one is not ten pixels"
            assert _white(image, 44, 30) else "a radius of one is over ten pixels"
        si

        @Test()
        An_arc_goes_counter_clockwise_from_its_first_angle() is
            let image = _image()

            image.view(0.0D, 0.0D, 60.0D, 60.0D)
            image.arc(30.0D, 30.0D, 20.0D, 270.0D, 90.0D)

            assert !_white(image, 50, 30) else "the right side is missing"
            assert _white(image, 10, 30) else "the left side was drawn"
        si

        @Test()
        An_arc_has_round_ends_and_goes_no_further() is
            let image = _image()

            image.view(0.0D, 0.0D, 60.0D, 60.0D)
            image.arc(30.0D, 30.0D, 20.0D, 0.0D, 90.0D)

            assert !_white(image, 49, 30) else "the start is missing"
            assert _white(image, 49, 36) else "the arc ran on past its start"
        si
    si

    @TestClass()
    class COLOUR_MAP_Tests is
        init() is si

        @Test()
        Each_map_starts_and_ends_where_it_says() is
            assert COLOUR_MAP.viridis(0.0D) =~ (red = 68ub, green = 1ub, blue = 84ub)
            assert COLOUR_MAP.viridis(1.0D) =~ (red = 253ub, green = 231ub, blue = 37ub)
            assert COLOUR_MAP.cool_warm(0.5D) =~ (red = 221ub, green = 221ub, blue = 221ub)
            assert COLOUR_MAP.hue(0.0D) =~ (red = 255ub, green = 0ub, blue = 0ub)
            assert COLOUR_MAP.hue(1.0D / 3.0D) =~ (red = 0ub, green = 255ub, blue = 0ub)
        si

        @Test()
        A_value_beyond_either_end_takes_that_end() is
            assert COLOUR_MAP.viridis(-3.0D) =~ COLOUR_MAP.viridis(0.0D)
            assert COLOUR_MAP.cool_warm(7.0D) =~ COLOUR_MAP.cool_warm(1.0D)
            assert COLOUR_MAP.viridis(double.na_n) =~ COLOUR_MAP.viridis(0.0D)
        si

        @Test()
        Hue_wraps() is
            assert COLOUR_MAP.hue(1.25D) =~ COLOUR_MAP.hue(0.25D)
            assert COLOUR_MAP.hue(-0.75D) =~ COLOUR_MAP.hue(0.25D)
        si

        @Test()
        A_colour_can_be_given_as_a_map_gives_it() is
            let image = IMAGE(2, 2)

            image.colour(COLOUR_MAP.viridis(1.0D))
            image.blend(0, 0, 1.0D)

            assert image.pixel(0, 0) =~ COLOUR_MAP.viridis(1.0D)
        si
    si

    @TestClass()
    class AXES_Tests is
        init() is si

        @Test()
        Ticks_fall_on_round_numbers() is
            let ticks = AXES.ticks(0.0D, 10.0D, 5)

            assert ticks.count == 6 else "{ticks.count} ticks"
            assert ticks[0] =~ 0.0D
            assert ticks[5] =~ 10.0D
        si

        @Test()
        Ticks_stay_within_the_range() is
            let ticks = AXES.ticks(-1.3D, 2.7D, 8)

            assert AXES.step(-1.3D, 2.7D, 8) =~ 0.5D
            assert ticks[0] =~ -1.0D
            assert ticks[ticks.count - 1] =~ 2.5D
        si

        @Test()
        A_label_carries_as_many_places_as_the_step_needs() is
            assert AXES.label(2.0D, [0.0D, 1.0D]) =~ "2"
            assert AXES.label(0.5D, [0.0D, 0.5D]) =~ "0.5"
            assert AXES.label(0.3D - 0.1D, [0.0D, 0.1D]) =~ "0.2"
            assert AXES.label(-0.0000000001D, [0.0D, 0.1D]) =~ "0.0"
        si

        @Test()
        The_frame_is_drawn_round_the_view() is
            let image = IMAGE(100, 100)

            image.view(0.0D, 0.0D, 1.0D, 1.0D, 20.0D)

            image.colour(0ub, 0ub, 0ub)
            image.stroke(2.0D)

            AXES(image).draw()

            let white = (red = 255ub, green = 255ub, blue = 255ub)

            assert image.pixel(50, 20) !~ white else "no top edge"
            assert image.pixel(80, 50) !~ white else "no right edge"
            assert image.pixel(50, 80) !~ white else "no bottom edge"
            assert image.pixel(20, 50) !~ white else "no left edge"
            assert image.pixel(50, 50) =~ white else "ink inside the frame"
        si
    si

    @TestClass()
    class TEXT_ANCHOR_Tests is
        init() is si

        // The leftmost and rightmost columns anything was drawn in.
        _extent(image: IMAGE) -> (left: int, right: int) =>
            (let columns =
                 (0..image.width)
                     |> filter(x =>
                         (0..image.height)
                             |> filter(y =>
                                 image.pixel(x, y) !~
                                     (red = 255ub, green = 255ub, blue = 255ub))
                             |> count() > 0)
                     |> collect()

             (left = columns[0], right = columns[columns.count - 1]))

        _drawn(anchor: Anchor) -> (left: int, right: int) =>
            (let image = IMAGE(200, 40)

             image.colour(0ub, 0ub, 0ub)
             image.text(100.0D, 30.0D, 12.0D, "HHH", anchor)

             _extent(image))

        @Test()
        Left_text_starts_at_its_position() is
            let drawn = _drawn(Anchor.LEFT)

            assert Math.abs(drawn.left - 100) <= 4 else "starts at {drawn.left}"
        si

        @Test()
        Right_text_ends_at_its_position() is
            let drawn = _drawn(Anchor.RIGHT)

            assert Math.abs(drawn.right - 100) <= 4 else "ends at {drawn.right}"
        si

        @Test()
        Centred_text_straddles_its_position() is
            let drawn = _drawn(Anchor.CENTRE)

            assert Math.abs(drawn.left + drawn.right - 200) <= 2
                else "runs from {drawn.left} to {drawn.right}"
        si

        @Test()
        Upward_text_is_taller_than_it_is_wide() is
            let image = IMAGE(60, 200)

            image.colour(0ub, 0ub, 0ub)
            image.upward_text(40.0D, 100.0D, 12.0D, "HHHH", Anchor.CENTRE)

            let across = _extent(image)

            assert across.right - across.left < 20
                else "{across.right - across.left} pixels wide"
        si
    si

    @TestClass()
    class ANIMATION_Tests is
        init() is si

        // The kinds of chunk in a PNG, in order.
        _kinds(bytes: ubyte[]) -> Collections.List[string] =>
            (let kinds = Collections.LIST[string]()
             let at mut = 8

             while at < bytes.count do
                 let length =
                     (cast int(bytes[at]) << 24) | (cast int(bytes[at + 1]) << 16) |
                     (cast int(bytes[at + 2]) << 8) | cast int(bytes[at + 3])

                 kinds.add(
                     "{cast char(bytes[at + 4])}{cast char(bytes[at + 5])}"
                     "{cast char(bytes[at + 6])}{cast char(bytes[at + 7])}"
                 )

                 at = at + 12 + length
             od

             kinds)

        _frames(count: int) -> ANIMATION =>
            (let animation = ANIMATION(20, 20)
             let image = IMAGE(20, 20)

             for index in 0..count do
                 image.clear()
                 image.colour(cast ubyte(index * 60), 0ub, 0ub)
                 image.disc(10.0D, 10.0D, 6.0D)

                 animation.add(image, 100)
             od

             animation)

        @Test()
        Frames_after_the_first_are_frame_data() is
            let kinds = _kinds(_frames(3).encode())

            assert (kinds |> join(" ")) =~
                "IHDR acTL fcTL IDAT fcTL fdAT fcTL fdAT IEND"
                else "chunks were {kinds |> join(" ")}"
        si

        @Test()
        A_reader_that_knows_no_animation_sees_the_first_frame() is
            let animation = ANIMATION(20, 20)
            let first = IMAGE(20, 20)
            let second = IMAGE(20, 20)

            first.colour(200ub, 0ub, 0ub)
            first.disc(10.0D, 10.0D, 6.0D)
            second.colour(0ub, 0ub, 200ub)
            second.disc(10.0D, 10.0D, 6.0D)

            animation.add(first, 100)
            animation.add(second, 100)

            let read = IMAGE.decode(animation.encode())

            assert read.pixel(10, 10) =~ first.pixel(10, 10)
            assert read.pixel(0, 0) =~ first.pixel(0, 0)
        si

        @Test()
        A_frame_is_a_copy_of_the_image_when_it_was_added() is
            let animation = ANIMATION(20, 20)
            let image = IMAGE(20, 20)

            image.colour(0ub, 200ub, 0ub)
            image.disc(10.0D, 10.0D, 6.0D)

            animation.add(image, 50)

            image.clear()

            assert IMAGE.decode(animation.encode()).pixel(10, 10) =~
                (red = 0ub, green = 200ub, blue = 0ub)
                else "clearing the image changed the frame already added"
        si

        @Test()
        The_same_frames_encode_to_the_same_bytes() is
            let first = _frames(2).encode()
            let second = _frames(2).encode()

            assert first.count == second.count

            for at in 0..first.count do
                assert first[at] == second[at] else "byte {at} differs"
            od
        si

        @Test()
        A_frame_of_the_wrong_size_is_refused() is
            let animation = ANIMATION(20, 20)

            try
                animation.add(IMAGE(10, 20), 100)

                assert false else "a narrower frame was accepted"
            catch _: System.ArgumentException
            yrt
        si

        @Test()
        The_loop_count_is_what_was_asked() is
            let animation = _frames(1)

            animation.loops = 3

            let bytes = animation.encode()

            // The animation control chunk follows the 25 bytes of the
            // signature and header: length, kind, frame count, then plays.
            assert bytes[33 + 4 + 4 + 3] == 1ub else "frame count is not 1"
            assert bytes[33 + 4 + 4 + 7] == 3ub else "loop count is not 3"
        si
    si

    @TestClass()
    class ANIMATION_READ_Tests is
        init() is si

        _animation() -> ANIMATION =>
            (let animation = ANIMATION(24, 16)
             let image = IMAGE(24, 16)

             for index in 0..3 do
                 image.clear()
                 image.colour(cast ubyte(80 * index), 40ub, 200ub)
                 image.disc(4.0D + 7.0D * cast double(index), 8.0D, 4.0D)

                 animation.add(image, 40 + 30 * index)
             od

             animation.loops = 2

             animation)

        @Test()
        Every_frame_reads_back_as_it_was_written() is
            let written = _animation()
            let read = ANIMATION.decode(written.encode())

            assert read.frame_count == 3 else "{read.frame_count} frames"
            assert read.loops == 2

            for index in 0..3 do
                assert read.delay(index) == written.delay(index)
                    else "frame {index} delay {read.delay(index)}"

                let a = read.frame(index).rgb()
                let b = written.frame(index).rgb()

                for at in 0..a.count do
                    assert a[at] == b[at] else "frame {index} byte {at} differs"
                od
            od
        si

        @Test()
        A_still_image_reads_as_one_frame() is
            let image = IMAGE(8, 8)

            image.colour(0ub, 0ub, 0ub)
            image.line(0.0D, 0.0D, 8.0D, 8.0D)

            let read = ANIMATION.decode(image.encode())

            assert read.frame_count == 1
            assert read.frame(0).pixel(4, 4) =~ image.pixel(4, 4)
        si
    si

    @TestClass()
    class GIF_Tests is
        init() is si

        // Enough of a GIF reader to check the writer: the screen size, the
        // global palette, and each frame's pixels as colours, plus the delays.
        _decode(bytes: ubyte[]) -> (width: int, height: int, palette: Collections.List[int],
                                    frames: Collections.List[Collections.List[int]],
                                    delays: Collections.List[int], loop: int) =>
            (let width = cast int(bytes[6]) | (cast int(bytes[7]) << 8)
             let height = cast int(bytes[8]) | (cast int(bytes[9]) << 8)
             let entries = 2 << (cast int(bytes[10]) & 7)

             let palette = Collections.LIST[int]()

             for index in 0..entries do
                 palette.add(
                     (cast int(bytes[13 + index * 3]) << 16) |
                     (cast int(bytes[14 + index * 3]) << 8) |
                     cast int(bytes[15 + index * 3]))
             od

             let frames = Collections.LIST[Collections.List[int]]()
             let delays = Collections.LIST[int]()
             let loop mut = -1
             let at mut = 13 + entries * 3

             while bytes[at] != 0x3Bub do
                 if bytes[at] == 0x21ub then
                     let label = bytes[at + 1]

                     if label == 0xF9ub then
                         delays.add(cast int(bytes[at + 4]) | (cast int(bytes[at + 5]) << 8))
                     elif label == 0xFFub then
                         loop = cast int(bytes[at + 16]) | (cast int(bytes[at + 17]) << 8)
                     fi

                     at = at + 2

                     while bytes[at] != 0ub do
                         at = at + 1 + cast int(bytes[at])
                     od

                     at = at + 1
                 else
                     at = at + 10

                     let minimum = cast int(bytes[at])
                     let data = Collections.LIST[ubyte]()

                     at = at + 1

                     while bytes[at] != 0ub do
                         for offset in 1::cast int(bytes[at]) do
                             data.add(bytes[at + offset])
                         od

                         at = at + 1 + cast int(bytes[at])
                     od

                     at = at + 1

                     frames.add(
                         _lzw(data, minimum) |> map(index => palette[index]) |> collect_mutable())
                 fi
             od

             (width = width, height = height, palette = palette,
              frames = frames, delays = delays, loop = loop))

        _lzw(data: Collections.List[ubyte], minimum: int) -> Collections.List[int] =>
            (let clear = 1 << minimum
             let finish = clear + 1
             let table = Collections.LIST[Collections.List[int]]()
             let out = Collections.LIST[int]()

             let size mut = minimum + 1
             let bit mut = 0
             let previous: Collections.List[int]? mut = null

             let reset = () is
                 table.clear()

                 for index in 0..clear + 2 do
                     table.add([index])
                 od

                 size = minimum + 1
                 previous = null
             si

             reset()

             do
                 let code mut = 0

                 for offset in 0..size do
                     let at = bit + offset

                     if (cast int(data[at / 8]) >> (at % 8)) & 1 == 1 then
                         code = code | (1 << offset)
                     fi
                 od

                 bit = bit + size

                 if code == clear then
                     reset()
                     continue
                 fi

                 if code == finish then
                     break
                 fi

                 let entry =
                     if code < table.count then
                         table[code]
                     elif let before = previous then
                         before |> cat([before[0]]) |> collect_mutable()
                     else
                         throw System.Exception("code {code} before any entry")
                     fi

                 for index in entry do
                     out.add(index)
                 od

                 if let before = previous then
                     if table.count < 4096 then
                         table.add(before |> cat([entry[0]]) |> collect_mutable())
                     fi
                 fi

                 if table.count == (1 << size) /\ size < 12 then
                     size = size + 1
                 fi

                 previous = entry
             od

             out)

        _colours(image: IMAGE) -> Collections.List[int] =>
            (let rgb = image.rgb()

             (0..rgb.count / 3)
                 |> map(at =>
                     (cast int(rgb[at * 3]) << 16) |
                     (cast int(rgb[at * 3 + 1]) << 8) |
                     cast int(rgb[at * 3 + 2]))
                 |> collect_mutable())

        @Test()
        Few_colours_come_back_exactly() is
            let animation = ANIMATION(30, 20)
            let image = IMAGE(30, 20)

            image.colour(200ub, 30ub, 30ub)
            image.set_pixel(3, 3, 10ub, 20ub, 30ub)
            animation.add(image, 100)

            image.set_pixel(4, 4, 1ub, 2ub, 3ub)
            animation.add(image, 250)

            let gif = _decode(animation.encode_gif())

            assert gif.width == 30 /\ gif.height == 20
            assert gif.frames.count == 2
            assert gif.loop == 0 else "loops {gif.loop}"
            assert gif.delays[0] == 10 /\ gif.delays[1] == 25

            for index in 0..2 do
                let expected = _colours(animation.frame(index))

                for at in 0..expected.count do
                    assert gif.frames[index][at] == expected[at]
                        else "frame {index} pixel {at}"
                od
            od
        si

        @Test()
        Many_colours_share_a_palette_of_256_near_them() is
            let animation = ANIMATION(64, 64)
            let image = IMAGE(64, 64)

            for y in 0..64 do
                for x in 0..64 do
                    image.set_pixel(x, y, cast ubyte(x * 4), cast ubyte(y * 4), cast ubyte((x + y) * 2))
                od
            od

            animation.add(image, 50)

            let bytes = animation.encode_gif()
            let gif = _decode(bytes)
            let expected = _colours(image)

            assert gif.palette.count == 256

            for at in 0..expected.count do
                let a = gif.frames[0][at]
                let b = expected[at]

                for shift in [0, 8, 16] do
                    assert Math.abs(((a >> shift) & 0xFF) - ((b >> shift) & 0xFF)) < 24
                        else "pixel {at} strayed from {b} to {a}"
                od
            od

            let again = animation.encode_gif()

            assert again.count == bytes.count

            for at in 0..bytes.count do
                assert again[at] == bytes[at] else "byte {at} differs between encodings"
            od
        si

        @Test()
        A_large_frame_runs_the_code_table_full_and_clears_it() is
            let animation = ANIMATION(200, 150)
            let image = IMAGE(200, 150)
            let random = System.Random(7)

            for y in 0..150 do
                for x in 0..200 do
                    let shade = cast ubyte(random.next(0, 200))

                    image.set_pixel(x, y, shade, shade, shade)
                od
            od

            animation.add(image, 50)

            let gif = _decode(animation.encode_gif())
            let expected = _colours(image)

            assert gif.frames[0].count == expected.count

            for at in 0..expected.count do
                assert gif.frames[0][at] == expected[at] else "pixel {at}"
            od
        si

        @Test()
        Playing_once_leaves_out_the_loop_and_a_count_is_of_repeats() is
            let animation = ANIMATION(4, 4)

            animation.add(IMAGE(4, 4), 10)

            animation.loops = 1

            assert _decode(animation.encode_gif()).loop == -1

            animation.loops = 3

            assert _decode(animation.encode_gif()).loop == 2
        si

        @Test()
        Delays_are_rounded_to_hundredths_and_no_shorter_than_two() is
            let animation = ANIMATION(4, 4)

            for delay in [0, 14, 15, 26, 1000] do
                animation.add(IMAGE(4, 4), delay)
            od

            let delays = _decode(animation.encode_gif()).delays

            assert delays[0] == 2 /\ delays[1] == 2 /\ delays[2] == 2
                else "{delays[0]} {delays[1]} {delays[2]}"
            assert delays[3] == 3 /\ delays[4] == 100
        si
    si

    @TestClass()
    class SHAPES_Tests is
        init() is si

        _square_halves(image: IMAGE, together: bool) is
            let red = (red = 200ub, green = 40ub, blue = 40ub)

            let first = [(x = 4.0D, y = 4.0D), (x = 36.0D, y = 4.0D), (x = 36.0D, y = 30.0D)]
            let second = [(x = 4.0D, y = 4.0D), (x = 36.0D, y = 30.0D), (x = 4.0D, y = 30.0D)]

            if together then
                let shapes = SHAPES()

                shapes.add(first, red)
                shapes.add(second, red)

                image.fill(shapes)
            else
                image.colour(red)
                image.fill(first)
                image.fill(second)
            fi
        si

        _pale_inside(image: IMAGE) -> int =>
            (6..34)
                |> map(x =>
                    (6..28)
                        |> filter(y => image.pixel(x, y) !~ (red = 200ub, green = 40ub, blue = 40ub))
                        |> count())
                |> reduce(0, (a, b) => a + b)

        @Test()
        Shapes_filled_apart_leave_a_seam_where_they_meet() is
            let image = IMAGE(40, 34)

            _square_halves(image, false)

            assert _pale_inside(image) > 0
                else "no seam, so this test no longer shows what filling together fixes"
        si

        @Test()
        Shapes_filled_together_meet_without_a_seam() is
            let image = IMAGE(40, 34)

            _square_halves(image, true)

            assert _pale_inside(image) == 0 else "{_pale_inside(image)} pale pixels inside"
        si

        @Test()
        Shapes_filled_together_keep_their_own_colours() is
            let image = IMAGE(40, 20)

            let shapes = SHAPES()

            shapes.add([(x = 0.0D, y = 0.0D), (x = 20.0D, y = 0.0D), (x = 20.0D, y = 20.0D), (x = 0.0D, y = 20.0D)], 255ub, 0ub, 0ub)
            shapes.add([(x = 20.0D, y = 0.0D), (x = 40.0D, y = 0.0D), (x = 40.0D, y = 20.0D), (x = 20.0D, y = 20.0D)], 0ub, 0ub, 255ub)

            image.fill(shapes)

            assert image.pixel(5, 10) =~ (red = 255ub, green = 0ub, blue = 0ub)
            assert image.pixel(35, 10) =~ (red = 0ub, green = 0ub, blue = 255ub)
        si

        @Test()
        A_rectangle_fills_between_its_corners() is
            let image = IMAGE(20, 20)

            image.colour(0ub, 0ub, 0ub)
            image.fill_rectangle(5.0D, 5.0D, 15.0D, 12.0D)

            assert image.pixel(10, 8) =~ (red = 0ub, green = 0ub, blue = 0ub)
            assert image.pixel(10, 14) =~ (red = 255ub, green = 255ub, blue = 255ub)
        si

        @Test()
        Clearing_to_a_colour_paints_every_pixel() is
            let image = IMAGE(7, 5)

            image.clear(10ub, 20ub, 30ub)

            for y in 0..5 do
                for x in 0..7 do
                    assert image.pixel(x, y) =~ (red = 10ub, green = 20ub, blue = 30ub)
                        else "{x}, {y}"
                od
            od
        si

        @Test()
        A_pixel_can_be_set_to_the_current_colour() is
            let image = IMAGE(4, 4)

            image.colour(1ub, 2ub, 3ub)
            image.set_pixel(2, 1)

            assert image.pixel(2, 1) =~ (red = 1ub, green = 2ub, blue = 3ub)
        si
    si

    @TestClass()
    class AXES_FIT_Tests is
        init() is si

        _columns_inked(image: IMAGE, x: int) -> int =>
            (0..image.height)
                |> filter(y => image.pixel(x, y) !~ (red = 255ub, green = 255ub, blue = 255ub))
                |> count()

        @Test()
        Fitted_axes_keep_every_label_inside_the_image() is
            let image = IMAGE(300, 200)
            let axes = AXES(image)

            axes.x_title = "time"
            axes.y_title = "height"
            axes.fit(0.0D, -12500.0D, 10.0D, 2500.0D)
            axes.draw()

            assert _columns_inked(image, 0) == 0 else "ink in the leftmost column"
            assert _columns_inked(image, 1) == 0 else "ink in the second column"

            for x in 0..image.width do
                assert image.pixel(x, image.height - 1) =~ (red = 255ub, green = 255ub, blue = 255ub)
                    else "ink on the bottom row at {x}"
            od
        si

        @Test()
        A_view_can_have_a_margin_on_each_side() is
            let image = IMAGE(100, 100)

            image.view(0.0D, 0.0D, 1.0D, 1.0D, (left = 30.0D, bottom = 20.0D, right = 10.0D, top = 5.0D))

            assert image.to_pixel(0.0D, 1.0D) =~ (x = 30.0D, y = 5.0D)
            assert image.to_pixel(1.0D, 0.0D) =~ (x = 90.0D, y = 80.0D)
        si
    si

    @TestClass()
    class MARKER_Tests is
        init() is si

        _white(image: IMAGE, x: int, y: int) -> bool =>
            image.pixel(x, y) =~ (red = 255ub, green = 255ub, blue = 255ub)

        @Test()
        A_dot_is_round_however_the_view_is_scaled() is
            let image = IMAGE(100, 100)

            image.view(0.0D, 0.0D, 100000.0D, 360.0D)
            image.colour(0ub, 0ub, 0ub)
            image.dot(50000.0D, 180.0D, 5.0D)

            assert !_white(image, 50, 50) else "the middle is not marked"
            assert !_white(image, 53, 50) /\ !_white(image, 50, 53)
                else "the dot is not round"
            assert _white(image, 58, 50) /\ _white(image, 50, 58)
                else "the dot is bigger than its radius"
        si

        @Test()
        A_ring_leaves_its_middle() is
            let image = IMAGE(40, 40)

            image.colour(0ub, 0ub, 0ub)
            image.ring(20.0D, 20.0D, 8.0D)

            assert _white(image, 20, 20) else "the middle is marked"
            assert !_white(image, 28, 20) else "the ring is missing"
        si
    si

    @TestClass()
    class AXES_TICKS_Tests is
        init() is si

        @Test()
        Given_ticks_replace_the_round_numbers() is
            let plain = IMAGE(200, 150)
            let given = IMAGE(200, 150)

            for image in [plain, given] do
                image.view(0.5D, 0.0D, 9.5D, 10.0D, 30.0D)
            od

            AXES(plain).draw()

            let axes = AXES(given)

            axes.x_ticks((1::9) |> map(digit => (value = cast double(digit), label = "{digit}")) |> collect_mutable())
            axes.draw()

            let differs =
                (0..200)
                    |> filter(x => (120..150) |> filter(y => plain.pixel(x, y) !~ given.pixel(x, y)) |> count() > 0)
                    |> count()

            assert differs > 0 else "the given ticks changed nothing below the frame"
        si

        @Test()
        A_key_shows_a_swatch_of_its_colour() is
            let image = IMAGE(200, 150)

            image.view(0.0D, 0.0D, 1.0D, 1.0D, 30.0D)

            let axes = AXES(image)

            axes.key("found", 200ub, 30ub, 30ub)
            axes.draw()

            let swatches =
                (0..200)
                    |> filter(x =>
                        (0..150)
                            |> filter(y => image.pixel(x, y) =~ (red = 200ub, green = 30ub, blue = 30ub))
                            |> count() > 0)
                    |> count()

            assert swatches > 4 else "no swatch in the key's colour"

            assert image.current_colour =~ (red = 0ub, green = 0ub, blue = 0ub)
                else "drawing the key left the colour changed"
        si
    si

    @TestClass()
    class DEFLATE_Tests is
        init() is si

        _samples: Collections.List[ubyte[]] static =>
            [
                Collections.LIST[ubyte]().to_array(),
                [42ub],
                (0..100_000) |> map(i => cast ubyte(i % 7)) |> collect(),
                (0..50_000) |> map(i => cast ubyte((i * 7919 + i / 3) % 251)) |> collect(),
                (0..70_000) |> map(i => if i % 1000 < 900 then 255ub else cast ubyte(i % 256) fi) |> collect()
            ]

        _platform_decompress(data: ubyte[]) -> ubyte[] static is
            let stream = System.IO.Compression.DeflateStream(IO.MemoryStream(data), System.IO.Compression.CompressionMode.DECOMPRESS)
            let out = IO.MemoryStream()

            stream.copy_to(out)

            return out.to_array()
        si

        _same(expected: ubyte[], actual: ubyte[], what: string) static is
            assert expected.count == actual.count else "{what}: {actual.count} bytes, expected {expected.count}"

            for i in 0..expected.count do
                assert expected[i] == actual[i] else "{what}: byte {i} differs"
            od
        si

        @Test()
        The_platform_reads_what_is_compressed() is
            for sample in _samples do
                _same(sample, _platform_decompress(DEFLATE.compress(sample)), "platform read of {sample.count}")
            od
        si

        @Test()
        Repetitive_data_compresses() is
            let sample = (0..100_000) |> map(i => cast ubyte(i % 7)) |> collect()

            assert DEFLATE.compress(sample).count < 2_000
        si
    si
si
